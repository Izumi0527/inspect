{
  "name": "inspect-system-frontend",
  "version": "1.1.0",
  "description": "企业级网络设备巡检系统前端",
  "private": true,
  "scripts": {
    "dev": "next dev -p 13000",
    "build": "pnpm run type-check && next build --no-lint",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "build:stats": "npx webpack-bundle-analyzer .next/analyze/client.js",
    "quality": "pnpm lint && pnpm type-check && pnpm test:coverage",
    "quality:fix": "pnpm lint:fix && pnpm type-check && pnpm test",
    "validate": "pnpm quality && pnpm build",
    "clean": "rm -rf .next out dist coverage",
    "clean:modules": "rm -rf node_modules package-lock.json && npm install",
    "update:deps": "npm update && npm audit fix"
  },
