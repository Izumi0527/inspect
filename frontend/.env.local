# 后端API地址配置
# 开发环境使用本地后端服务
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket地址配置（如果需要实时通信功能）
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==================== 开发环境配置 ====================
# 禁用认证检查（仅用于前端开发调试）
# - true:  跳过登录验证，直接访问监控页面（仅开发环境）
# - false: 需要登录才能访问（生产环境默认）
# ⚠️ 警告：生产环境必须设置为 false 或不设置此变量！
NEXT_PUBLIC_DISABLE_AUTH_CHECK=false

# ==================== 监控中心数据源配置 ====================
# 控制监控中心 v2 是否使用 Mock 数据
# - true:  使用前端生成的 Mock 数据(用于前端独立开发)
# - false: 使用后端 API 真实数据(需要后端服务正常运行)
NEXT_PUBLIC_USE_MOCK_DATA=false

# 注意：
# - 修改此文件后需要重启前端开发服务器才能生效
# - 此文件已被 .gitignore 忽略，不会提交到版本控制
# - 生产环境请使用环境变量或专门的生产环境配置
