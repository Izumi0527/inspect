# 环境变量配置模板
# 复制此文件为 .env.local 并根据实际情况修改配置

# ========================================
# 后端API配置
# ========================================

# 后端API基础URL
# 开发环境: http://localhost:8000
# 生产环境: https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket地址（用于实时通信）
# 开发环境: ws://localhost:8000
# 生产环境: wss://your-api-domain.com
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ========================================
# 功能开关
# ========================================

# 是否启用调试模式
# NEXT_PUBLIC_DEBUG=false

# 是否启用性能监控
# NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITOR=false

# ========================================
# 第三方服务
# ========================================

# 如果需要集成第三方服务，在此添加配置
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# ========================================
# 说明
# ========================================
# 1. NEXT_PUBLIC_ 前缀的变量会暴露到浏览器端
# 2. 没有此前缀的变量只在服务器端可用
# 3. 修改 .env.local 后需要重启开发服务器
# 4. .env.local 文件会被 git 忽略，不会提交到版本控制
