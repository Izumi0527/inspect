# Inspect installer runtime configuration

NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

SECRET_KEY=change-me-generated-on-first-start
JWT_SECRET_KEY=change-me-generated-on-first-start
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SERVER_HOST=127.0.0.1
SERVER_PORT=9165

NEXT_PUBLIC_API_URL=http://127.0.0.1:9165
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:9165

DATABASE_URL=postgresql://inspect_dev:__DB_PASSWORD__@127.0.0.1:15500/inspect_system_dev
# 供 docker-compose.installer.yml 注入 Postgres 容器（与 DATABASE_URL 同口令，由 prepare-env.ps1 首启生成）
POSTGRES_PASSWORD=__DB_PASSWORD__
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
DB_AUTO_MIGRATE=true
TIMESCALE_ENABLED=true

REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:26380/0
# 供 docker-compose.installer.yml 注入 Redis 容器（与 REDIS_URL 同口令，由 prepare-env.ps1 首启生成）
REDIS_PASSWORD=__REDIS_PASSWORD__
MONITORING_CACHE_ENABLED=true
MONITORING_CACHE_TTL=30s

CORS_ORIGINS=["http://localhost:13000","http://127.0.0.1:13000"]
ALLOWED_HOSTS=["*"]

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_FILE=../logs/backend-go/app.log

REPORT_OUTPUT_DIR=../data/reports/monitoring
REPORTS_OUTPUT_DIR=../data/reports
MONITORING_REPORT_DOWNLOAD_TOKEN_TTL=5m
MONITORING_REPORT_DOWNLOAD_TOKEN_MAX_USES=3

SNMP_TRAP_ENABLED=false
SNMP_TRAP_HOST=0.0.0.0
SNMP_TRAP_PORT=162

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@inspect.local
FROM_NAME=Inspect

DEFAULT_SNMP_COMMUNITY=public
# 设备探测默认 SSH 凭据：出于安全默认置空，请在安装后按需填写（留空表示不使用默认凭据）。
DEFAULT_SSH_USERNAME=
DEFAULT_SSH_PASSWORD=
DEVICE_MONITORING_INTERVAL=60
DEVICE_CONNECTION_TIMEOUT=30

ENABLE_METRICS=false
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
