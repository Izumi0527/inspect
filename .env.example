# ==========================================
# 企业级网络设备巡检系统 - 环境配置示例
# 复制此文件为 .env 并根据实际环境修改配置
# ==========================================

# ==========================================
# 环境标识
# ==========================================
# 运行环境: development | production
NODE_ENV=development
ENVIRONMENT=development

# ==========================================
# 前端配置 (Next.js)
# ==========================================
# 后端API服务地址 (前端可访问的公开配置)
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket连接地址
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==========================================
# 基础应用配置
# ==========================================
# 调试模式: true | false
DEBUG=true
# 应用密钥 - 生产环境必须使用强随机密钥
SECRET_KEY=your-super-secret-key-change-in-production
# 允许访问的主机列表
ALLOWED_HOSTS=["*"]

# ==========================================
# 数据库配置 (PostgreSQL)
# ==========================================
# PostgreSQL数据库连接URL格式:
# postgresql://用户名:密码@主机:端口/数据库名
# 开发环境示例:
DATABASE_URL=postgresql://inspect_dev:dev_password_2024@localhost:5433/inspect_system_dev
# 生产环境示例:
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/inspect_db

# 数据库连接池配置
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
DB_AUTO_MIGRATE=true
TIMESCALE_ENABLED=true

# ==========================================
# Redis缓存配置
# ==========================================
# Redis连接URL格式: redis://:密码@主机:端口/数据库编号
# 开发环境示例:
REDIS_URL=redis://:dev_redis_2024@localhost:6380/0
# 生产环境示例:
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ==========================================
# TimescaleDB 时序配置说明
# ==========================================
# TimescaleDB 复用 PostgreSQL 连接配置，无需额外环境变量

# ==========================================
# JWT令牌配置
# ==========================================
# JWT签名密钥 - 生产环境必须使用强随机密钥
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
# JWT算法
JWT_ALGORITHM=HS256
# 访问令牌过期时间(分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 刷新令牌过期时间(天)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CORS跨域配置
# ==========================================
# 允许跨域访问的源列表 (JSON数组格式)
# 开发环境示例:
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
# 生产环境示例:
# CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# ==========================================
# 日志配置
# ==========================================
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志格式: console | json
LOG_FORMAT=json
# 日志文件路径
LOG_FILE=logs/backend-go/app.log

# ==========================================
# SNMP Trap 接收配置
# ==========================================
# 是否启用SNMP Trap监听
SNMP_TRAP_ENABLED=false
# Trap监听地址
SNMP_TRAP_HOST=0.0.0.0
# Trap监听端口（162为标准端口，可能需要管理员权限）
SNMP_TRAP_PORT=162

# ==========================================
# 报表导出配置
# ==========================================
# 监控报表导出目录
REPORT_OUTPUT_DIR=data/reports/monitoring
REPORTS_OUTPUT_DIR=data/reports

# ==========================================
# 邮件通知配置
# ==========================================
# SMTP服务器地址
SMTP_HOST=localhost
# SMTP服务器端口
SMTP_PORT=587
# SMTP用户名
SMTP_USER=
# SMTP密码
SMTP_PASSWORD=
# 发件人邮箱
FROM_EMAIL=noreply@inspect.local
# 发件人名称
FROM_NAME=网络设备巡检系统

# ==========================================
# 服务端口配置 (Go 后端)
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==========================================
# 设备监控默认凭据配置
# ==========================================
# 默认SNMP Community字符串
DEFAULT_SNMP_COMMUNITY=public
# 默认SSH用户名 (如果设备未配置SSH凭据时使用)
DEFAULT_SSH_USERNAME=admin
# 默认SSH密码 (如果设备未配置SSH凭据时使用)
DEFAULT_SSH_PASSWORD=admin
# 设备监控间隔(秒)
DEVICE_MONITORING_INTERVAL=60
# 设备连接超时时间(秒)
DEVICE_CONNECTION_TIMEOUT=30

# ==========================================
# 使用指南
# ==========================================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改相应配置项
# 3. 启动服务: ./scripts/dev-start.sh
#
# 生产环境部署:
# 1. 复制为 .env.production: cp .env.example .env.production
# 2. 修改为生产环境配置
# 3. 设置环境变量: export ENV_FILE=.env.production
# 4. 启动服务: ./scripts/prod-deploy.sh
