# ==========================================
# 企业级网络设备巡检系统 - 生产环境配置
# ==========================================

# ==========================================
# 环境标识
# ==========================================
NODE_ENV=production
ENVIRONMENT=production

# ==========================================
# 前端配置 (Next.js)
# ==========================================
# API 服务地址 - 生产环境需要配置实际域名
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# ==========================================
# 基础应用配置
# ==========================================
DEBUG=false
# 生产环境必须使用强密钥
SECRET_KEY=${SECRET_KEY}
ALLOWED_HOSTS=["yourdomain.com", "api.yourdomain.com"]

# ==========================================
# 数据库配置 (PostgreSQL - 生产环境)
# ==========================================
# PostgreSQL数据库连接URL - 使用环境变量
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/inspect_db
# 数据库连接池配置 - 生产环境优化
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
DB_AUTO_MIGRATE=true
TIMESCALE_ENABLED=true

# ==========================================
# Redis缓存配置 (生产环境)
# ==========================================
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ==========================================
# TimescaleDB 时序配置说明
# ==========================================
# TimescaleDB 复用 PostgreSQL 连接配置，无需额外环境变量

# ==========================================
# JWT令牌配置
# ==========================================
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CORS跨域配置
# ==========================================
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/backend-go/app.log

# ==========================================
# 邮件通知配置
# ==========================================
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=网络设备巡检系统

# ==========================================
# 服务端口配置 (Go 后端)
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==========================================
# 监控和性能配置
# ==========================================
# 启用生产监控
ENABLE_METRICS=true
METRICS_PORT=9090

# 健康检查配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ==========================================
# 备份配置
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
