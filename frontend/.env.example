# ==========================================
# 前端环境变量配置模板
# ==========================================
# 说明：
# 1. 复制此文件为 .env.local: cp .env.example .env.local
# 2. 根据实际环境修改配置项
# 3. .env.local 文件会被 git 忽略，不会提交到版本控制
# ==========================================

# ==========================================
# 后端API配置
# ==========================================

# 后端API基础URL
# 开发环境: http://localhost:38000
# 生产环境: https://your-api-domain.com
# Windows 环境提示：部分机器会把 8000/8001 等端口划入 excluded port range，导致后端无法监听（报错 access permissions）。
# 如遇该问题，请将端口统一调整到 30000+（例如 38000），并重启前端。
NEXT_PUBLIC_API_URL=http://localhost:38000

# WebSocket地址（用于实时通信）
# 开发环境: ws://localhost:38000
# 生产环境: wss://your-api-domain.com
NEXT_PUBLIC_WS_URL=ws://localhost:38000

# ==========================================
# 开发环境配置
# ==========================================

# 禁用认证检查（仅用于前端开发调试）
# - true:  跳过登录验证，直接访问监控页面（仅开发环境）
# - false: 需要登录才能访问（生产环境默认）
# ⚠️ 警告：生产环境必须设置为 false 或不设置此变量！
NEXT_PUBLIC_DISABLE_AUTH_CHECK=false

# ==========================================
# 功能开关
# ==========================================

# 是否启用调试模式
NEXT_PUBLIC_DEBUG=false

# 是否启用性能监控
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITOR=false

# ==========================================
# 测试环境配置（E2E测试使用）
# ==========================================

# E2E测试时的API地址
# API_URL=http://localhost:8080

# 测试数据库配置（用于后端测试）
# TEST_DATABASE_URL=host=localhost user=inspect_dev password=inspect_dev_password dbname=inspect_system_dev port=5432 sslmode=disable

# 测试模式标识
# NODE_ENV=test

# 禁用遥测数据收集
# NEXT_TELEMETRY_DISABLED=1

# ==========================================
# 第三方服务（可选）
# ==========================================

# Google Analytics 跟踪ID
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Sentry 错误追踪DSN
# NEXT_PUBLIC_SENTRY_DSN=

# ==========================================
# 重要说明
# ==========================================
# 1. NEXT_PUBLIC_ 前缀的变量会暴露到浏览器端
# 2. 没有此前缀的变量只在服务器端可用
# 3. 修改 .env.local 后需要重启开发服务器
# 4. 生产环境请使用环境变量或专门的生产环境配置
