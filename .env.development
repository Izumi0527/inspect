# ==========================================
# 企业级网络设备巡检系统 - 开发环境配置
# ==========================================

# ==========================================
# 环境标识
# ==========================================
NODE_ENV=development
ENVIRONMENT=development

# ==========================================
# 前端配置 (Next.js)
# ==========================================
# API 服务地址
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==========================================
# 基础应用配置
# ==========================================
DEBUG=true
SECRET_KEY=dev-secret-key-not-for-production-2024
ALLOWED_HOSTS=["*"]

# ==========================================
# 数据库配置 (PostgreSQL - 开发环境端口)
# ==========================================
# PostgreSQL数据库连接URL
DATABASE_URL=postgresql://inspect_dev:dev_password_2024@localhost:5433/inspect_system_dev
# 数据库连接池配置
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=true
DB_AUTO_MIGRATE=true
TIMESCALE_ENABLED=true

# ==========================================
# Redis缓存配置 (开发环境端口)
# ==========================================
REDIS_URL=redis://:dev_redis_2024@localhost:6380/0

# ==========================================
# TimescaleDB 时序配置说明
# ==========================================
# TimescaleDB 复用 PostgreSQL 连接配置，无需额外环境变量

# ==========================================
# JWT令牌配置
# ==========================================
JWT_SECRET_KEY=dev-jwt-secret-key-not-for-production-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# CORS跨域配置
# ==========================================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001"]

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_FILE=logs/backend-go/app-dev.log

# ==========================================
# 邮件通知配置（开发环境禁用）
# ==========================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@dev.inspect.local
FROM_NAME=网络设备巡检系统[开发]

# ==========================================
# 服务端口配置 (Go 后端)
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
